__pycache__/
*.py[cod]
.venv/
.cache/
**/build/
**/machines/
**/access/
**/artifacts/
*.u64
*.u64.gz
*.zip
*.tar.gz
.env
*.pem
*.key

# Retain the curated public SSH host keys; other access files stay excluded.
!main_code/common/phase1/access/
main_code/common/phase1/access/*
!main_code/common/phase1/access/known_hosts

# New competition execution outputs are retained outside version control.
competition-runs/
estimator.*.stdout
estimator.*.stderr

# Preserve curated Phase-III compiler/assembly provenance, not build binaries.
!phase3/hazel/runs/**/build/
phase3/hazel/runs/**/build/*
!phase3/hazel/runs/**/build/*.json
